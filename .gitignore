# Secrets. API keys live in .env, which is never committed; .env.example is
# the committed template and must hold no real key (doctor.py checks).
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python and tooling caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Spark writes these into the working directory when a session starts.
spark-warehouse/
metastore_db/
derby.log

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Generated output. Every run writes a report, a run record and a fitted model,
# and can write them again; a run's report records where each was saved.
reports/*
!reports/.gitkeep
runs/
models/
*.log

# Replayed model responses. Regenerated on demand and machine-local;
# useful to keep between runs, not to commit.
.llm_cache/

# Generated by datasets/make_large_transactions.py (129 MB). Regenerate rather
# than commit: the seed is fixed, so the file is reproducible byte for byte.
datasets/large_transactions.csv

# Downloaded by datasets/fetch_benchmark_data.py (one command, from OpenML and
# scikit-learn). Not committed: credit_card_fraud.csv and covertype.csv exceed
# GitHub's 100 MB file limit, and the rest are one command away.
datasets/bank_marketing.csv
datasets/credit_card_fraud.csv
datasets/covertype.csv
datasets/kaggle_house_prices.csv
datasets/telco_churn.csv
datasets/miniboone.csv

# benchmarks/ is deliberately NOT ignored: it holds the measured results the
# README, the report and the slides cite, so they are reviewable with the code.
