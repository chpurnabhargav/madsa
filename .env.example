# Copy this file to .env and paste in a key for whichever provider you use.
# .env is gitignored: keys stay on this machine and are never committed.
#
# ONE key is enough to run. But if you have more than one, use:
#   python run.py datasets/heart_disease.csv --backend auto
# which tries each configured provider in turn and moves to the next when one
# hits its rate limit, instead of waiting for the allowance to replenish. On
# free tiers that waiting dominates the run time, so a second key roughly
# halves how long a full sweep takes and costs nothing.
#
# To pin a single provider instead:
#   python run.py datasets/heart_disease.csv --backend gemini
#
# None of these use the local GPU. The model runs on the provider's servers and
# only JSON crosses the network, so hardware here is irrelevant.

# --- Anthropic (Claude) ---------------------------------------------------
# Key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Gemini --------------------------------------------------------
# Key from aistudio.google.com/apikey. Gemini offers a free tier with rate
# limits, which is usually enough to produce the results for a report.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- xAI (Grok) -----------------------------------------------------------
# Key from console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-3
# Any OpenAI-compatible endpoint works here, not only xAI.
GROK_BASE_URL=https://api.x.ai/v1

# --- Groq -----------------------------------------------------------------
# Key from console.groq.com. NOT the same as Grok above: Groq (with a q) is an
# inference provider for open models such as Llama, and its keys begin with
# "gsk_", where xAI's Grok keys begin with "xai-". The two are constantly
# confused, so each backend rejects the other's key rather than failing later
# with an unhelpful authentication error.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (a locally served open-weight model) --------------------------
# Needs a multi-gigabyte model download and enough VRAM; the hosted options
# above avoid both.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
